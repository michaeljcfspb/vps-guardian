# =============================================================================
# VPS GUARDIAN — arquivo de variáveis de ambiente
#
# COMO USAR (na VPS, dentro da pasta do projeto):
#   1) cp .env.example .env
#   2) Preencha os 4 valores marcados com  <<< OBRIGATÓRIO
#   3) docker compose up -d --build
#
# O que acontece: o MySQL 8 sobe, a API espera o banco ficar pronto e aplica as
# migrations automaticamente. Depois disso a API responde em /health.
#
# Este arquivo NUNCA deve ser versionado. O .env real fica só no servidor
# (ou no gerenciador de variáveis do Easypanel).
#
# Gerar segredos fortes (senhas e chave da aplicação):
#    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APLICAÇÃO
# -----------------------------------------------------------------------------
GUARDIAN_APP_ENV=production
GUARDIAN_DEPLOYMENT_VERSION=0.1.0
GUARDIAN_LOG_LEVEL=INFO
GUARDIAN_LOG_JSON=true

# Chave de assinatura/criptografia de sessões.
# <<< OBRIGATÓRIO — mínimo 32 caracteres. Trocar depois invalida todas as sessões.
GUARDIAN_SECRET_KEY=

# URL pública da API (usada para montar o register_url do agente).
# Ex.: https://guardian.seudominio.com
# Deixe vazio se ainda não houver domínio (retorna caminho relativo).
GUARDIAN_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# 2. BANCO DE DADOS — senhas
# -----------------------------------------------------------------------------
# Senha do usuário root do MySQL (usada só internamente pelo container).
# <<< OBRIGATÓRIO — use uma senha longa e única.
MYSQL_ROOT_PASSWORD=

# Senha do usuário da aplicação (privilégio mínimo sobre o banco).
# <<< OBRIGATÓRIO — NÃO reutilize a senha do root.
GUARDIAN_DB_PASSWORD=

# Nome do banco e usuário da aplicação (podem ficar assim).
GUARDIAN_DB_NAME=vps_guardian
GUARDIAN_DB_USER=guardian

# -----------------------------------------------------------------------------
# 3. BANCO DE DADOS — conexão
# -----------------------------------------------------------------------------
# No modo "stack completo" (docker-compose.yml) o host é sempre `mysql`,
# fixado pelo próprio compose. Não precisa alterar.
GUARDIAN_DB_HOST=mysql
GUARDIAN_DB_PORT=3306

# ALTERNATIVA: usar o MySQL já existente do Easypanel.
# Comente/remova as linhas GUARDIAN_DB_HOST/PORT/NAME/USER/PASSWORD acima e use
# a URL completa abaixo (ATENÇÃO: a senha precisa de URL-encoding manual):
#   GUARDIAN_DATABASE_URL=mysql+pymysql://guardian:SENHA@mysql-interno:3306/vps_guardian
# GUARDIAN_DATABASE_URL=

# Pool de conexões (padrões adequados para nove servidores monitorados).
GUARDIAN_DB_POOL_SIZE=10
GUARDIAN_DB_MAX_OVERFLOW=5
GUARDIAN_DB_POOL_RECYCLE_SECONDS=1800

# -----------------------------------------------------------------------------
# 4. AUTOMAÇÃO DE INSTALAÇÃO
# -----------------------------------------------------------------------------
# Esperar o MySQL e aplicar `alembic upgrade head` ao iniciar a API.
# Mantenha true para que `docker compose up -d` já deixe o sistema pronto.
GUARDIAN_AUTO_MIGRATE=true
# Tempo máximo de espera pelo MySQL no boot (segundos).
GUARDIAN_DB_WAIT_TIMEOUT=180

# -----------------------------------------------------------------------------
# 5. SESSÃO DO PAINEL
# -----------------------------------------------------------------------------
# Validade absoluta e tempo de inatividade (minutos).
GUARDIAN_SESSION_TTL_MINUTES=720
GUARDIAN_SESSION_IDLE_TIMEOUT_MINUTES=120
# Em produção o cookie já é Secure automaticamente. Deixe comentado.
# GUARDIAN_COOKIE_DOMAIN=guardian.seudominio.com

# -----------------------------------------------------------------------------
# 6. REDE E PROXY
# -----------------------------------------------------------------------------
# IP(s) do proxy reverso (Traefik/Easypanel), separados por vírgula, para que a
# auditoria registre o IP real do cliente e não o do proxy.
# Ex.: GUARDIAN_TRUSTED_PROXY_IPS=10.0.0.2
GUARDIAN_TRUSTED_PROXY_IPS=

# Origens permitidas para o painel, separadas por vírgula, SEM barra final.
# Deixe vazio se o painel for servido no mesmo domínio da API.
# Ex.: GUARDIAN_CORS_ORIGINS=https://guardian.seudominio.com
GUARDIAN_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# 7. PROTEÇÃO CONTRA ABUSO (rate limiting)
# -----------------------------------------------------------------------------
GUARDIAN_LOGIN_MAX_ATTEMPTS=5
GUARDIAN_LOGIN_WINDOW_SECONDS=300
GUARDIAN_AGENT_MAX_REQUESTS_PER_MINUTE=20

# -----------------------------------------------------------------------------
# 8. PROVISIONAMENTO DE AGENTES
# -----------------------------------------------------------------------------
# Validade do token temporário exibido no painel (minutos).
GUARDIAN_PROVISIONING_TOKEN_TTL_MINUTES=15
# 0 = credencial permanente (recomendado para agentes).
GUARDIAN_AGENT_CREDENTIAL_TTL_DAYS=0

# -----------------------------------------------------------------------------
# 9. TESTES (não usar em produção)
# -----------------------------------------------------------------------------
# Banco separado para `pytest -m integration`. Nunca aponte para o banco real.
# GUARDIAN_TEST_DATABASE_URL=mysql+pymysql://guardian:SENHA@mysql:3306/vps_guardian_test
