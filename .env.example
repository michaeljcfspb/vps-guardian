# =============================================================================
# VPS Guardian — modelo de variáveis de ambiente
# Copie para `.env` no ambiente de destino. NUNCA versione o `.env` real.
# Todas as variáveis do backend usam o prefixo GUARDIAN_.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# development | staging | production
GUARDIAN_APP_ENV=production
GUARDIAN_DEPLOYMENT_VERSION=0.1.0
GUARDIAN_LOG_LEVEL=INFO
GUARDIAN_LOG_JSON=true

# --- Segurança ---------------------------------------------------------------
# Chave de assinatura/criptografia. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar este valor invalida sessões existentes.
GUARDIAN_SECRET_KEY=troque-por-um-valor-aleatorio-de-48-bytes-ou-mais

# TTL absoluto e ocioso da sessão do painel (minutos)
GUARDIAN_SESSION_TTL_MINUTES=720
GUARDIAN_SESSION_IDLE_TIMEOUT_MINUTES=120

# Deixe vazio para derivar automaticamente (true em production)
# GUARDIAN_COOKIE_SECURE=true
# GUARDIAN_COOKIE_DOMAIN=guardian.exemplo.com

# Origens permitidas no CORS, separadas por vírgula (sem barra final)
GUARDIAN_CORS_ORIGINS=https://guardian.exemplo.com

# --- Banco de dados (MySQL do Easypanel, rede privada) -----------------------
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:3306/vps_guardian
# A senha deve ser URL-encoded se contiver caracteres especiais.
GUARDIAN_DATABASE_URL=mysql+pymysql://guardian:SENHA@mysql-interno:3306/vps_guardian

# Pool de conexões
GUARDIAN_DB_POOL_SIZE=10
GUARDIAN_DB_MAX_OVERFLOW=5
GUARDIAN_DB_POOL_RECYCLE_SECONDS=1800
GUARDIAN_DB_ECHO=false

# --- Rate limiting -----------------------------------------------------------
GUARDIAN_LOGIN_MAX_ATTEMPTS=5
GUARDIAN_LOGIN_WINDOW_SECONDS=300

# --- Provisionamento de agentes ---------------------------------------------
GUARDIAN_PROVISIONING_TOKEN_TTL_MINUTES=15
GUARDIAN_AGENT_CREDENTIAL_TTL_DAYS=0

# --- Banco de testes (apenas CI/VPS; nunca SQLite) --------------------------
# GUARDIAN_TEST_DATABASE_URL=mysql+pymysql://guardian:SENHA@127.0.0.1:3306/vps_guardian_test
